# Multi-stage production build for FraudLens Frontend + Caddy HTTPS Edge Proxy
# Build context: ./frontend
# Stage 1 compiles the React + Vite SPA with mocks strictly disabled.
# Stage 2 serves /srv via Caddy 2 (automatic Let's Encrypt HTTPS + /api & /ws reverse proxy).

FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ENV VITE_USE_MOCKS=false
RUN npm run build

FROM caddy:2.8-alpine

COPY --from=builder /app/dist /srv

EXPOSE 80 443
