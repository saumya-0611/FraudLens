# FraudLens Single-VM Production Environment Template
# Copy to .env.prod on your VM (NEVER commit .env.prod to git):
#   cp .env.prod.example .env.prod
#
# Replace EVERY secret and password below with unique random values:
#   openssl rand -hex 32

# --- Public Domain & Automatic HTTPS (Caddy) ---
# Option A (Custom domain with DNS A record -> VM IP):
#   SITE_ADDRESS=fraudlens.yourdomain.com
#   PUBLIC_ORIGIN=https://fraudlens.yourdomain.com
# Option B (No domain purchased - FREE Let's Encrypt HTTPS using sslip.io):
#   SITE_ADDRESS=203.0.113.10.sslip.io
#   PUBLIC_ORIGIN=https://203.0.113.10.sslip.io
# Option C (Local HTTP-only smoke test):
#   SITE_ADDRESS=:80
#   PUBLIC_ORIGIN=http://localhost:8080
#   COOKIE_SECURE=false
SITE_ADDRESS=fraudlens.example.com
PUBLIC_ORIGIN=https://fraudlens.example.com
ACME_EMAIL=admin@example.com
COOKIE_SECURE=true
HTTP_PORT=80
HTTPS_PORT=443

# --- PostgreSQL ---
POSTGRES_USER=fraudlens
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=fraudlens
DATABASE_URL=postgresql://fraudlens:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/fraudlens

# --- Internal Service Addresses ---
KAFKA_BROKERS=kafka:9092
ML_SERVICE_URL=http://ml-service:8000
KAFKA_HEAP_OPTS=-Xmx512M -Xms256M
# Use "spark" on 4+ GB RAM VMs, or "fallback" (Python Kafka consumer) on 2 GB RAM VMs
STREAM_ENGINE=spark

# --- Auth & Service Tokens (generate each with `openssl rand -hex 32`) ---
JWT_SECRET=REPLACE_WITH_64_HEX_CHAR_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=2h
SERVICE_TOKEN=REPLACE_WITH_RANDOM_INGEST_SERVICE_TOKEN
INTERNAL_ML_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_ML_TOKEN

# --- Seeded Users (must satisfy strong password policy; never start with change_me) ---
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD_1!
SEED_ANALYST_PASSWORD=REPLACE_WITH_STRONG_ANALYST_PASSWORD_1!
SEED_VIEWER_PASSWORD=REPLACE_WITH_STRONG_VIEWER_PASSWORD_1!

# --- Optional Social OAuth (keep false until schema migration & provider credentials are configured) ---
SOCIAL_OAUTH_ENABLED=false
# Exact approved HTTPS origin, with no path or trailing slash.
OAUTH_PUBLIC_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
