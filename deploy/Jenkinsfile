// FraudLens Pre-Flight Gatekeeper Pipeline (adapted from BhashaFlow CI/CD workflow)
// Uses offset host ports (Frontend: 6173, Backend: 6000) and isolated project name (fraudlens_ci)
// so Jenkins builds never collide with a developer's local stack on 5173/5000.

pipeline {
    agent any

    environment {
        COMPOSE_PROJECT_NAME = 'fraudlens_ci'
        FRONTEND_HOST_PORT   = '6173'
        BACKEND_HOST_PORT    = '6000'
        COMPOSE_ENV_FILES    = '.env.ci'
        FRAUDLENS_ENV_FILE   = '.env.ci'
    }

    stages {
        stage('1. Environment & Contract Sanity') {
            steps {
                sh '''
                    test -f docs/CONTRACTS.md
                    test -f database/init.sql
                    test -f shared/thresholds.json
                    sh scripts/prepare_ci_env.sh
                    docker compose config --quiet
                '''
            }
        }

        stage('2. Backend Unit Tests') {
            steps {
                dir('backend') {
                    sh 'npm ci && npm test'
                }
            }
        }

        stage('3. ML Service & Feature Parity Tests') {
            steps {
                sh '''
                    docker build -f ml-service/Dockerfile -t fraudlens-ml-ci .
                    docker run --rm fraudlens-ml-ci pytest -v tests/
                '''
            }
        }

        stage('4. Docker Pre-Flight Build & Health Gate') {
            steps {
                sh '''
                    docker compose -p ${COMPOSE_PROJECT_NAME} up --build --wait --wait-timeout 180 backend
                    docker compose -p ${COMPOSE_PROJECT_NAME} exec -T backend wget -qO- http://localhost:5000/ready
                    docker compose -p ${COMPOSE_PROJECT_NAME} exec -T ml-service curl -fsS -I http://localhost:8000/ready
                '''
            }
        }
    }

    post {
        always {
            sh 'docker compose -p ${COMPOSE_PROJECT_NAME} down -v --remove-orphans || true'
        }
    }
}
