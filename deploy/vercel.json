{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fraudlens-backend.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://fraudlens-backend.onrender.com/health"
    },
    {
      "source": "/api-docs",
      "destination": "https://fraudlens-backend.onrender.com/api-docs"
    },
    {
      "source": "/api-docs/:path*",
      "destination": "https://fraudlens-backend.onrender.com/api-docs/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
