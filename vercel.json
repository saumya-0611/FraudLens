{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fraudlens-backend-j17p.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://fraudlens-backend-j17p.onrender.com/health"
    },
    {
      "source": "/ready",
      "destination": "https://fraudlens-backend-j17p.onrender.com/ready"
    },
    {
      "source": "/api-docs",
      "destination": "https://fraudlens-backend-j17p.onrender.com/api-docs"
    },
    {
      "source": "/api-docs/:path*",
      "destination": "https://fraudlens-backend-j17p.onrender.com/api-docs/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
